* {
    bg: #ebdbb290;
    fg: #d5c4a1;
    bordersel: #7c6f64;
    select: #d65d0e80;
    txt: #282828;
    null: #00000000;

    background-color: @bg;
    border-color: @fg;
    color: @txt;
    dark: #FFFFFF;
    border: 0px;
}

window {
    width: 1000;
    location: center;
    anchor: center;
    spacing: 0;
    children: [mainbox];
    orientation: horizontal;
}

mainbox {
    border: 5px;
    children: [ inputbar, message, listview ];
}

message {
    padding: 5px;
}

inputbar {
    padding: 10px;
    border: 0px 0px 5px 0px;
}

entry,prompt,case-indicator {
    background-color: @null;
    vertical-align: 0.5;
}

prompt {
    border-color: @bordersel;
    border: 0px 5px 0px 0px;
    padding: 0px 10px 0px 0px;
    margin: 0px 10px 0px 0px;
}

listview {
    background-color: @null;
    lines: 10;
}

element {
    background-color: @null;
    padding: 5px;
    vertical-align: 0.5;
    font: inherit;
}

element-text {
    background-color: @null;
    vertical-align: 0.5;
    text-color: inherit;
}

element-icon {
    background-color: @null;
    border-color: inherit;
    size: 0.8em;
    margin: 0px 10px 0px 5px;
    padding: 0px 0px 0px 10px;
    border: 0px 0px 0px 5px;
}

element selected.normal {
    background-color: @select;
    border-color: @bordersel;
}
